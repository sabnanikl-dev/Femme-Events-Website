# Local, inert measurement fixture build (issue #161).
#
# Loaded only by `vite --mode measurement-fixture` / `vite build --mode
# measurement-fixture`, which is never how the site is built for production.
# All three of the mode name, the opt-in token below and a loopback host are
# required before any adapter code runs, so these values cannot switch
# measurement on in a production deployment.
#
# The measurement id is a placeholder. It is never used to reach Google: the
# fixture transport hands the load to a locally installed inert tag, and the
# browser fixtures block every external request before navigation.
VITE_MEASUREMENT_FIXTURE=local-inert-fixture
VITE_GA4_MEASUREMENT_ID=G-FIXTURE0000
# `.invalid` is reserved by RFC 6761 and can never resolve. The browser fixtures
# intercept this endpoint locally, so no synthetic inquiry can leave the machine.
VITE_FORMSPREE_ENDPOINT=https://formspree.invalid/f/local-inert-fixture
